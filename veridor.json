{
  "version": 1,
  "target": { "base_url": "http://127.0.0.1:8080", "timeout_seconds": 3 },
  "identities": {
    "acme_user": {
      "headers": { "Authorization": "Bearer ${ACME_TOKEN}" },
      "marker": "vdr-Xk7Qm2Ls9Rt4Vb8Nc3Zp6Wf1"
    },
    "globex_user": {
      "headers": { "Authorization": "Bearer ${GLOBEX_TOKEN}" },
      "marker": "vdr-Bq3Wm8Ke5Tz1Yx7Rn2Hd4Vs6",
      "marker_probe": { "method": "GET", "path": "/api/invoices/inv-200" }
    },
    "anonymous": { "headers": {} }
  },
  "checks": [
    {
      "id": "invoice-tenant-isolation",
      "name": "A tenant cannot read another tenant's invoice",
      "request": { "method": "GET", "path": "/api/invoices/inv-100" },
      "expect": {
        "acme_user": { "status": [200], "contains_marker": "acme_user" },
        "globex_user": { "status": [404], "excludes_marker": "acme_user" },
        "anonymous": { "status": [401] }
      }
    }
  ]
}
